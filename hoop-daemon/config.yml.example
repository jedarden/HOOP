# HOOP daemon configuration file
#
# Location: ~/.hoop/config.yml
#
# Configuration precedence (highest to lowest):
#   1. CLI flags (--addr, --observer, etc.)
#   2. Environment variables (HOOP_*)
#   3. config.yml (this file)
#   4. Compiled defaults
#
# Hot-reload: All changes to this file are applied immediately without restart,
#             except for keys marked [RESTART REQUIRED].
#
# Secret values: Use environment variables for API keys, secrets, and credentials.
#               Never store secrets in this file - it may appear in logs and audit trails.

schema_version: "1.0.0"

# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
server:
  # Server bind address [RESTART REQUIRED]
  # Default: "127.0.0.1:3000"
  # Env var: HOOP_BIND_ADDR
  bind_addr: "127.0.0.1:3000"

  # Allow br version mismatch (skip compatibility check)
  # Default: false
  # Env var: HOOP_ALLOW_BR_MISMATCH
  allow_br_mismatch: false

# ---------------------------------------------------------------------------
# Agent Configuration
# ---------------------------------------------------------------------------
agent:
  # LLM adapter to use
  # Options: claude, codex, opencode, gemini, aider
  # Default: "claude"
  # Env var: HOOP_AGENT_ADAPTER
  adapter: "claude"

  # Model name (adapter-specific)
  # Default: "claude-sonnet-4-20250514"
  # Env var: HOOP_AGENT_MODEL
  model: "claude-sonnet-4-20250514"

  # Anthropic API key (use env var for security)
  # Default: null
  # Env var: HOOP_AGENT_ANTHROPIC_API_KEY
  anthropic_api_key: null

  # ZAI proxy URL (optional)
  # Default: null
  # Env var: HOOP_ZAI_BASE_URL
  zai_base_url: null

  # ZAI API key (optional)
  # Default: null
  # Env var: HOOP_ZAI_API_KEY
  zai_api_key: null

  # Rate limit in requests per minute
  # Default: null (unlimited)
  # Env var: HOOP_RATE_LIMIT_RPM
  rate_limit_rpm: null

  # Cost cap in USD (stop when exceeded)
  # Default: null (no cap)
  # Env var: HOOP_COST_CAP_USD
  cost_cap_usd: null

# ---------------------------------------------------------------------------
# Projects Configuration
# ---------------------------------------------------------------------------
# Path to projects.yaml file
# Default: "~/.hoop/projects.yaml"
# Env var: HOOP_PROJECTS_FILE
projects_file: "~/.hoop/projects.yaml"

# ---------------------------------------------------------------------------
# UI Configuration
# ---------------------------------------------------------------------------
ui:
  # UI theme
  # Options: auto, light, dark, solarized-light, solarized-dark
  # Default: "auto"
  # Env var: HOOP_UI_THEME
  theme: "auto"

  # Default project sort order
  # Options: name, last_activity, cost_today, worker_count
  # Default: "last_activity"
  # Env var: HOOP_UI_SORT
  default_project_sort: "last_activity"

  # Auto-archive inactive projects after N days
  # Default: 30
  # Env var: HOOP_ARCHIVE_DAYS
  archive_after_days: 30

# ---------------------------------------------------------------------------
# Metrics Configuration
# ---------------------------------------------------------------------------
metrics:
  # Enable Prometheus metrics endpoint
  # Default: false
  # Env var: HOOP_METRICS_ENABLED
  enabled: false

  # Metrics server port [RESTART REQUIRED if enabled=true]
  # Default: 9091
  # Env var: HOOP_METRICS_PORT
  port: 9091

# ---------------------------------------------------------------------------
# Voice Configuration
# ---------------------------------------------------------------------------
voice:
  # Path to Whisper model file
  # Default: null (uses bundled model)
  # Env var: HOOP_WHISPER_MODEL_PATH
  whisper_model_path: null

  # Voice input hotkey
  # Default: "Ctrl+Shift+V"
  # Env var: HOOP_VOICE_HOTKEY
  hotkey: "Ctrl+Shift+V"

  # Maximum recording duration in seconds
  # Default: 300
  # Env var: HOOP_VOICE_MAX_SECONDS
  max_recording_seconds: 300

# ---------------------------------------------------------------------------
# Agent Extensions (§22)
# ---------------------------------------------------------------------------
agent_extensions:
  # Skills directory
  # Default: null
  # Env var: HOOP_AGENT_EXTENSIONS_SKILLS
  skills: null

  # Scripts directory
  # Default: null
  # Env var: HOOP_AGENT_EXTENSIONS_SCRIPTS
  scripts: null

  # Notes directory
  # Default: null
  # Env var: HOOP_AGENT_EXTENSIONS_NOTES
  notes: null

  # Prompts directory
  # Default: null
  # Env var: HOOP_AGENT_EXTENSIONS_PROMPTS
  prompts: null

# ---------------------------------------------------------------------------
# Audit Configuration
# ---------------------------------------------------------------------------
audit:
  # Audit log retention in days
  # Default: 90
  # Env var: HOOP_AUDIT_RETENTION_DAYS
  retention_days: 90

  # Enable hash chain for audit log integrity
  # Default: true
  # Env var: HOOP_AUDIT_HASH_CHAIN
  hash_chain: true

# ---------------------------------------------------------------------------
# Reflection Detection Configuration
# ---------------------------------------------------------------------------
reflection:
  # Enable reflection pattern detection
  # Default: true
  # Env var: HOOP_REFLECTION_ENABLED
  enabled: true

  # Detection threshold (0.0 - 1.0)
  # Default: 0.8
  # Env var: HOOP_REFLECTION_THRESHOLD
  detection_threshold: 0.8

  # Auto-archive detected reflections after N days
  # Default: 30
  # Env var: HOOP_REFLECTION_ARCHIVE_DAYS
  auto_archive_after_days: 30

# ---------------------------------------------------------------------------
# Backup Configuration (§15.2, §17.3)
# ---------------------------------------------------------------------------
backup:
  # S3 endpoint URL
  # Default: null
  # Env var: (none - use config.yml only)
  endpoint: null

  # S3 bucket name
  # Default: null
  bucket: null

  # S3 key prefix
  # Default: null
  prefix: null

  # Backup schedule (cron expression: minute hour day month dow)
  # Default: "0 4 * * *" (daily at 4 AM)
  schedule: "0 4 * * *"

  # Backup retention in days
  # Default: 30
  # Env var: HOOP_BACKUP_RETENTION_DAYS
  retention_days: 30

  # Enable age encryption for backups
  # Default: false
  encryption: false

# ---------------------------------------------------------------------------
# Pricing Configuration (§17.3)
# ---------------------------------------------------------------------------
# Path to pricing.yml file
# Default: "~/.hoop/pricing.yml"
# Env var: HOOP_PRICING_FILE
pricing_file: "~/.hoop/pricing.yml"

# ---------------------------------------------------------------------------
# Secrets Scanner Patterns (§18)
# ---------------------------------------------------------------------------
# Custom secret scanning patterns
# Default: (built-in patterns for common secrets)
#
# Each pattern has:
# - id: Unique snake_case identifier (used for pattern matching and filtering)
# - name: Human-readable display name
# - severity: "high", "medium", or "low"
# - patterns: List of regex patterns that match this secret type
#
# NOTE: This is the full set of built-in patterns. If you omit this section
# from your config.yml, all of these patterns will be used by default.
# You can customize by copying only the patterns you want to modify.
secrets_patterns:
  - id: "stripe_api_key"
    name: "Stripe API Key"
    severity: "high"
    patterns:
      - "\\bsk_live_[0-9a-zA-Z]{24,}\\b"
      - "\\bsk_test_[0-9a-zA-Z]{24,}\\b"
      - "\\bir_live_[0-9a-zA-Z]{32,}\\b"
      - "\\bir_test_[0-9a-zA-Z]{32,}\\b"

  - id: "openai_api_key"
    name: "OpenAI API Key"
    severity: "high"
    patterns:
      - "\\bsk-[a-zA-Z0-9]{48}\\b"
      - "\\bsk-proj-[a-zA-Z0-9_-]{48,}\\b"

  - id: "anthropic_api_key"
    name: "Anthropic API Key"
    severity: "high"
    patterns:
      - "sk-ant-[a-zA-Z0-9_-]{20,}"

  - id: "generic_sk_key"
    name: "Generic API Key"
    severity: "high"
    patterns:
      - "\\bsk-[a-zA-Z0-9]{20,}\\b"

  - id: "aws_access_key"
    name: "AWS Access Key"
    severity: "high"
    patterns:
      - "\\bAKIA[A-Z0-9]{16}\\b"
      - "\\bASIA[A-Z0-9]{16}\\b"

  - id: "aws_secret_key"
    name: "AWS Secret Access Key"
    severity: "high"
    patterns:
      - "(?i)aws_secret_access_key\\s*[:=]\\s*[A-Za-z0-9/+=]{40}\\b"

  - id: "github_token"
    name: "GitHub Token"
    severity: "high"
    patterns:
      - "\\bghp_[a-zA-Z0-9]{36}\\b"
      - "\\bghs_[a-zA-Z0-9]{36}\\b"
      - "\\bghu_[a-zA-Z0-9]{36}\\b"
      - "\\bgithub_pat_[a-zA-Z0-9_]{82}\\b"

  - id: "slack_token"
    name: "Slack Token"
    severity: "high"
    patterns:
      - "\\bxoxb-[0-9A-Za-z-]{24,}\\b"
      - "\\bxoxp-[0-9A-Za-z-]{24,}\\b"

  - id: "jwt"
    name: "JWT"
    severity: "high"
    patterns:
      - "\\bey[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"

  - id: "bearer_token"
    name: "Bearer Token"
    severity: "high"
    patterns:
      - "(?i)bearer\\s+[A-Za-z0-9._\\-+/]{20,}"

  - id: "env_var_secret"
    name: "Environment Variable Secret"
    severity: "high"
    patterns:
      - "(?i)(?:api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|private[_-]?key|client[_-]?secret|anthropic[_-]?api[_-]?key|openai[_-]?api[_-]?key|github[_-]?token)\\s*[:=]\\s*[\"']?([A-Za-z0-9+/_.~\\-]{16,})[\"']?"

  - id: "json_secret_field"
    name: "JSON Secret Field"
    severity: "high"
    patterns:
      - "(?i)\"(?:password|passwd|secret|token|api_key|apikey|access_token|auth_token|private_key|client_secret)\"\\s*:\\s*\"([^\"]{8,})\""

# ---------------------------------------------------------------------------
# Stuck Detector Configuration (§C1, hoop-ttb.3.25)
# ---------------------------------------------------------------------------
# Project-specific stuck detection thresholds
# Default: (global defaults)
stuck_detector: null

# ---------------------------------------------------------------------------
# Role-Based Access Control (RBAC)
# ---------------------------------------------------------------------------
roles:
  # Viewers can read projects and sessions but cannot create drafts
  viewers:
    - "viewer@example.com"

  # Drafters can create and edit drafts
  drafters:
    - "drafter@example.com"

# ---------------------------------------------------------------------------
# Redaction Policy (§18.5)
# ---------------------------------------------------------------------------
# Global redaction policy for secrets detection.
# Per-project overrides in projects.yaml take precedence over this global policy.
#
# Actions:
#   - warn: Log findings but allow the operation (default)
#   - redact: Replace secrets with [REDACTED] in stored content
#   - reject: Block the operation entirely (e.g., attachment upload)
#
# Example:
# redaction:
#   action: warn
#   patterns: []  # empty = all default patterns enabled
redaction: null
