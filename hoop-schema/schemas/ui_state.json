{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hoop.dev/schemas/ui_state.json",
  "title": "UiState",
  "description": "UI state persisted across sessions",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "active_project": {
      "type": ["string", "null"],
      "description": "Currently active project"
    },
    "active_stitch": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "Currently active stitch"
    },
    "sidebar_width": {
      "type": "integer",
      "default": 300,
      "description": "Sidebar width in pixels"
    },
    "panel_layout": {
      "type": "object",
      "properties": {
        "fleet_visible": {
          "type": "boolean",
          "default": true
        },
        "beads_visible": {
          "type": "boolean",
          "default": true
        },
        "conversations_visible": {
          "type": "boolean",
          "default": true
        },
        "patterns_visible": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "bead_status": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["open", "closed"]
          }
        },
        "stitch_kind": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["operator", "dictated", "worker", "ad-hoc"]
          }
        },
        "conversation_filter": {
          "type": "string",
          "enum": ["all", "fleet", "operator", "ad-hoc", "dictated"],
          "default": "all",
          "description": "Persisted conversation-pane filter — fleet vs ad-hoc vs all"
        },
        "show_archived": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": ["light", "dark", "auto"],
      "default": "auto"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "prompts_dismissed": {
      "type": "object",
      "description": "Track which prompts have been dismissed (progressive capability introduction)",
      "default": {},
      "properties": {
        "whats_new_v1_1_0": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp when 'What's new' v1.1.0 prompt was dismissed, null if not dismissed"
        },
        "reflection_ledger_empty_30d": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp when 'Reflection Ledger empty' prompt was dismissed"
        },
        "pattern_suggestion_10plus": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp when 'Pattern suggestion' prompt was dismissed"
        },
        "agent_intro": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp when 'Agent intro' prompt was dismissed"
        },
        "mic_intro": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp when 'Mic intro' prompt was dismissed"
        }
      }
    },
    "feature_usage": {
      "type": "object",
      "description": "Track first usage of features for progressive introduction",
      "default": {},
      "properties": {
        "agent_first_used": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "First timestamp when agent was used"
        },
        "mic_first_used": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "First timestamp when dictation/mic was used"
        },
        "patterns_first_used": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "First timestamp when patterns were created/used"
        },
        "reflection_ledger_first_used": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "First timestamp when reflection ledger was used"
        }
      }
    },
    "last_seen_version": {
      "type": ["string", "null"],
      "description": "Last HOOP version seen by this operator (for 'What's new' detection)"
    },
    "prompts_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Global 'don't bug me' setting - when false, no progressive prompts are shown"
    }
  },
  "schema_version": "1.1.0"
}
